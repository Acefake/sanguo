[gd_resource type="Theme" load_steps=2 format=3]

; Editor-time default theme.
;
; Previously assets/theme_kaiti.tres only styled Button, using
; assets/ui/buttons/primary-normal.png -- a near-white gradient that was
; effectively invisible -- and nothing else inherited it, because every panel
; builds its own Theme.new(). Native controls therefore fell back to Godot
; defaults.
;
; The real definition is scripts/ui_theme.gd: it covers every control type and
; supplies the SAN8R-backed button slices, which cannot be expressed here
; because they are cut from the sprite atlas at load time. GameState installs it
; on the scene tree root at startup, so this resource only carries the values
; that are meaningful declaratively.

[sub_resource type="SystemFont" id="SystemFont_display"]
font_names = PackedStringArray("KaiTi", "楷体", "STKaiti")

[resource]
default_font = SubResource("SystemFont_display")
default_font_size = 15