{
  "version": 1,
  "note": "战斗特性 hook 注册表。百分比与概率 hook 的单来源与合计上限来自 Notion《特性接口与验收》10.1；behavior 类是局限特性的决策失败模式（军事页 十四-8），上限在本表逐项给出。better 表示该 hook 数值往哪个方向是“更好”，用于校验优势特性与局限特性方向不写反。 task 为该 hook 所在流程的 Notion task.kind，调用方没给 ctx.task 时按它判断特性触发条件；supply*/news触达/opinion过滤 只登记非战斗特性，战斗流程不读。",
  "caps": {
    "percent": {"common_min": 0.03, "common_max": 0.05, "elite_max": 0.08, "total": 0.1},
    "pp": {"common_max": 0.02, "elite_max": 0.03, "total": 0.05},
    "attribute_point": {"common_up": 2, "common_down": 3, "elite_up": 3, "total": 6}
  },
  "hooks": {
    "command整理": {"kind": "percent", "better": "lower", "reads": "带兵", "stage": "command", "unit": "hour", "formula": "command_hours×(1.2−0.4u带兵)，超出容量 2+floor(6u) 个标准单元时按比例排队", "task": "command_issue"},
    "formation整队": {"kind": "percent", "better": "lower", "reads": "布阵", "stage": "formation", "unit": "hour", "formula": "formation_hours×地形倍率×(1.3−0.5u布阵)；布阵即新版“机动”", "task": "formation_change"},
    "march行军": {"kind": "percent", "better": "lower", "reads": "布阵", "stage": "march", "unit": "hour", "formula": "单位路程耗时×(1.3−0.5u布阵)；仅改行军耗时，不改道路流量", "task": "march_start"},
    "special轮换": {"kind": "percent", "better": "lower", "reads": "治军", "stage": "specialized_action", "unit": "hour", "formula": "rotation_hours×(1.15−0.25u治军)；轮换越快，接战中组织损失越小", "task": "rotation"},
    "special齐射": {"kind": "percent", "better": "lower", "reads": "箭术", "stage": "specialized_action", "unit": "hour", "formula": "volley_hours×(1.15−0.25u箭术)；只改第一次队形/信号准备", "task": "volley_prepare"},
    "replan重规划": {"kind": "percent", "better": "lower", "reads": "应变", "stage": "planning", "unit": "hour", "formula": "replan_hours×(1.35−0.55u应变)；须已获知原方案失效", "task": "replan"},
    "intel误差": {"kind": "percent", "better": "lower", "reads": "料敌", "stage": "intelligence", "unit": "ratio", "formula": "σ0×(1−0.4u料敌)；保留来源共同偏差", "task": "intel_interpret"},
    "rally收拢": {"kind": "percent", "better": "higher", "reads": "治军", "stage": "recovery", "unit": "organization_per_day", "formula": "rally_base×(0.8+0.4u治军)"},
    "fatigue疲劳": {"kind": "percent", "better": "lower", "reads": "体魄", "stage": "recovery", "unit": "fatigue", "formula": "基础疲劳×(1.2−0.4u体魄)"},
    "engineering准备": {"kind": "percent", "better": "lower", "reads": "攻坚", "stage": "engineering", "unit": "worker_hour", "formula": "准备工时×(1.25−0.45u攻坚)", "task": "engineering_prepare"},
    "pursuit追击": {"kind": "percent", "better": "higher", "reads": "骑术", "stage": "pursuit", "unit": "casualty", "formula": "追击造成的俘获/伤亡×(1+mod)"},
    "withdraw撤离": {"kind": "percent", "better": "lower", "reads": "", "stage": "disengage", "unit": "casualty", "formula": "撤离途中所受追击损失×(1+mod)", "task": "retreat_reform"},
    "pressure失误": {"kind": "pp", "better": "lower", "reads": "沉着", "stage": "decision", "unit": "probability", "formula": "clamp(c×(0.45−0.3u沉着),0,0.45)；压力为0时不制造失误", "task": "command_issue"},
    "conceal暴露": {"kind": "pp", "better": "lower", "reads": "奇袭", "stage": "detection", "unit": "probability", "formula": "clamp(p0+0.25c−0.2u奇袭,0.05,0.95)；只在真实接触窗口抽一次", "task": "concealed_approach"},
    "ambush识破": {"kind": "pp", "better": "higher", "reads": "料敌", "stage": "intelligence", "unit": "probability", "formula": "暴露后被正确解读的概率 = clamp(1−intel误差,0.05,0.95)", "task": "intel_interpret"},
    "plan遗漏": {"kind": "pp", "better": "lower", "reads": "智计", "stage": "planning", "unit": "probability", "formula": "clamp(0.35+0.3d−0.3u智计,0.03,0.8)；只处理认知内已有约束", "task": "plan_build"},
    "personal失控": {"kind": "pp", "better": "lower", "reads": "骑术", "stage": "personal", "unit": "probability", "formula": "clamp(p0+0.3c−0.2u骑术,0.01,0.8)；不改军团骑兵", "task": "personal_riding"},
    "commit投入": {"kind": "behavior", "better": "neutral", "unit": "readiness", "source_max": 0.5, "total": 0.6, "formula": "主力投入前要求的协同就位度 = commit_readiness+mod；负值=协同未到位就投入（急躁）"},
    "pursuit深入": {"kind": "behavior", "better": "lower", "unit": "step", "source_max": 2, "total": 2, "formula": "追击停止深度 = pursuit_max_steps+mod；正值=越过最大深入（贪功、追击疏算）"},
    "disengage脱离": {"kind": "behavior", "better": "neutral", "unit": "organization_point", "source_max": 20, "total": 25, "formula": "脱离线 = disengage_line+mod；负值=到线不走（恋战），正值=组织未破先撤（怯战）"},
    "advice采纳": {"kind": "behavior", "better": "higher", "unit": "probability", "source_max": 0.15, "total": 0.15, "formula": "主将采纳参军建议的概率修正（刚愎为负）", "task": "opinion_receive"},
    "advice说服": {"kind": "behavior", "better": "higher", "unit": "probability", "source_max": 0.1, "total": 0.1, "formula": "参军建议被采纳的概率修正（言辞刻薄为负）", "task": "discussion"},
    "dissent违令": {"kind": "behavior", "better": "lower", "unit": "probability", "source_max": 0.05, "total": 0.1, "formula": "违令概率修正"},
    "supply编排": {"kind": "percent", "better": "lower", "reads": "", "stage": "logistics", "unit": "hour", "task": "convoy_schedule", "formula": "运输队发车编排耗时×(1+mod)；战斗探针不结算"},
    "supply验收": {"kind": "percent", "better": "lower", "reads": "", "stage": "logistics", "unit": "hour", "task": "supply_receive", "formula": "物资验收处理耗时×(1+mod)；战斗探针不结算"},
    "supply核账": {"kind": "percent", "better": "lower", "reads": "", "stage": "logistics", "unit": "hour", "task": "supply_audit", "formula": "补给账核对耗时×(1+mod)；战斗探针不结算"},
    "news触达": {"kind": "percent", "better": "higher", "reads": "名望", "stage": "influence", "unit": "people", "task": "news_propagate", "formula": "事迹信息触达人数×(1+mod)；战斗探针不结算"},
    "opinion过滤": {"kind": "pp", "better": "lower", "reads": "雅量", "stage": "council", "unit": "probability", "task": "opinion_receive", "formula": "因表达差异的意见过滤概率=clamp(0.35−0.25u容人+0.15c,0.05,0.5)+mod；战斗探针不结算"},
    "attribute": {"kind": "attribute_point", "better": "higher", "unit": "attribute_point", "formula": "当前属性+本任务有效点数后统一 E 换算；写作 attribute.<子属性>"}
  },
  "attribute_keys": ["带兵", "布阵", "水练", "奇袭", "治军", "智计", "沉着", "料敌", "应变", "辩才", "膂力", "体魄", "武艺", "骑术", "箭术", "农桑", "商贾", "吏治", "律法", "辞令", "威仪", "仁德", "忠义", "名望", "雅量", "攻坚"],
  "fields": {
    "ctx.terrain": {"type": "enum", "values": ["plains", "forest", "hills", "mountains", "river", "ford", "marsh", "city"]},
    "ctx.action": {"type": "enum", "values": ["march", "continue", "engage", "flank", "pursue", "hold", "defend", "withdraw", "besiege", "support"]},
    "ctx.in_contact": {"type": "bool"},
    "ctx.resting": {"type": "bool"},
    "ctx.pressure": {"type": "number"},
    "ctx.urgency": {"type": "number"},
    "ctx.independent_groups": {"type": "number"},
    "ctx.enemy_renown_gap": {"type": "number"},
    "ctx.subcommanders_assigned": {"type": "bool"},
    "ctx.lord_pride": {"type": "number"},
    "unit.infantry_ratio": {"type": "number"},
    "unit.cavalry_ratio": {"type": "number"},
    "unit.archer_ratio": {"type": "number"},
    "unit.training": {"type": "number"},
    "person.mounted": {"type": "bool"},
    "task.kind": {"type": "enum", "values": ["administration", "command_issue", "concealed_approach", "convoy_schedule", "discussion", "engineering_prepare", "formation_change", "intel_interpret", "march_start", "news_propagate", "opinion_receive", "personal_endurance", "personal_melee", "personal_riding", "plan_build", "procedure_check", "replan", "retreat_reform", "rotation", "supply_audit", "supply_receive", "terrain_prepare", "troop_training", "volley_prepare"]},
    "task.recipient_count": {"type": "number"},
    "task.plan_type": {"type": "enum", "values": ["flank", "ambush", "feint_cover", "pursuit", "fortified_defense", "multi_gate_defense", "reserve_reinforce", "rearguard"]},
    "task.discussion_type": {"type": "enum", "values": ["military_plan", "civil_policy"]},
    "task.case_type": {"type": "enum", "values": ["routine_registry", "litigation", "registration"]},
    "task.engineering_type": {"type": "enum", "values": ["siege", "fortification", "bridge", "assault_ladder"]},
    "intel.independent_groups": {"type": "number"},
    "intel.cross_checked": {"type": "bool"},
    "intel.plan_invalid_known": {"type": "bool"},
    "intel.route_alternatives": {"type": "number"},
    "intel.route_surveyed": {"type": "bool"},
    "intel.enemy_pattern_received": {"type": "bool"},
    "intel.subject": {"type": "enum", "values": ["reinforcement_eta"]},
    "intel.source_type": {"type": "enum", "values": ["tracks"]},
    "intel.received": {"type": "bool"},
    "intel.evidence_quality": {"type": "number"},
    "intel.attack_point_surveyed": {"type": "bool"},
    "ctx.communication": {"type": "bool"},
    "ctx.feint_executed": {"type": "bool"},
    "ctx.visibility_cover": {"type": "number"},
    "ctx.frontier_gate_count": {"type": "number"},
