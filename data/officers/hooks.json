    "ctx.rotation_path": {"type": "bool"},
    "ctx.riding_complexity": {"type": "number"},
    "ctx.route_passable": {"type": "bool"},
    "ctx.supply_ratio": {"type": "number"},
    "ctx.roster_verified": {"type": "bool"},
    "ctx.ledger_available": {"type": "bool"},
    "ctx.background_group_count": {"type": "number"},
    "ctx.discussion_process_valid": {"type": "bool"},
    "ctx.outsider_background": {"type": "bool"},
    "ctx.channel": {"type": "enum", "values": ["official_notice", "public_network"]},
    "ctx.network_available": {"type": "bool"},
    "ctx.procedure_checklist": {"type": "bool"},
    "unit.reserve_contact_ratio": {"type": "number"},
    "cargo.type": {"type": "enum", "values": ["grain", "military_mixed"]},
    "person.weapon_style": {"type": "enum", "values": ["polearm", "shield", "bow", "crossbow"]},
    "person.weapon_training_match": {"type": "bool"}
  },
  "mechanisms": {
    "first_contact_awe": "首次与敌方高名望主将正面接战时，敌方直属部队士气下降；同一目标一次",
    "victory_chain": "连续主动战胜后，下一场主动攻战首次接敌移动与士气冲击提高；失败清零"
  }
}
