{
  "version": 1,
  "note": "战斗特性库（MVP 子集）。trait_NNN 沿用 Notion 特性库编号；trait_cNN 为人物卡已有、MVP 清单没有的普通特性；flaw_* 为人格型局限；unique_* 为专属。名称与编号来自 MVP 范围 v0.1，具体机制在 v1.1 原文缺席时按名称与 hook 注册表推定，标 mechanism_basis=inferred，待策划对照特性库 v1.1 复核。",
  "traits": [
    {"id": "trait_001", "name": "明令", "tier": "common", "mechanism_basis": "inferred", "summary": "命令写得清楚：新命令传到各部的整理耗时短。",
     "effects": [{"hook": "command整理", "value": -0.05}]},
    {"id": "trait_003", "name": "营务", "tier": "common", "mechanism_basis": "inferred", "summary": "营中事务有条理：休整时组织恢复快，接战轮换顺。",
     "effects": [{"hook": "rally收拢", "value": 0.05, "when": [["ctx.resting", "==", true]]}, {"hook": "special轮换", "value": -0.03}]},
    {"id": "trait_004", "name": "步阵", "tier": "common", "mechanism_basis": "inferred", "summary": "步兵为主时展开整队快。",
     "effects": [{"hook": "formation整队", "value": -0.05, "when": [["unit.infantry_ratio", ">=", 0.6]]}]},
    {"id": "trait_009", "name": "收拢", "tier": "common", "mechanism_basis": "inferred", "summary": "败退或受挫后收拢散兵快。",
     "effects": [{"hook": "rally收拢", "value": 0.05}]},
    {"id": "trait_014", "name": "善退", "tier": "elite", "mechanism_basis": "inferred", "summary": "撤退时队形不乱：撤离途中所受追击损失少，撤离整队快。",
     "effects": [{"hook": "withdraw撤离", "value": -0.08}, {"hook": "formation整队", "value": -0.08, "when": [["ctx.action", "==", "withdraw"]]}]},
    {"id": "trait_016", "name": "急行", "tier": "common", "mechanism_basis": "inferred", "summary": "行军耗时短。",
     "effects": [{"hook": "march行军", "value": -0.05}]},
    {"id": "trait_020", "name": "核报", "tier": "common", "mechanism_basis": "inferred", "summary": "核对军报：敌情估计误差小。",
     "effects": [{"hook": "intel误差", "value": -0.05}]},
    {"id": "trait_025", "name": "复勘", "tier": "common", "mechanism_basis": "inferred", "summary": "计划前复查已知约束：计划遗漏少。",
     "effects": [{"hook": "plan遗漏", "value": -0.02}]},
    {"id": "trait_028", "name": "多源研判", "tier": "elite", "mechanism_basis": "inferred", "summary": "有两路以上独立来源时，敌情估计明显更准，伏兵更易被识破。",
     "effects": [{"hook": "intel误差", "value": -0.08, "when": [["ctx.independent_groups", ">=", 2]]}, {"hook": "ambush识破", "value": 0.03}]},
    {"id": "trait_033", "name": "山行", "tier": "common", "mechanism_basis": "inferred", "summary": "山地丘陵行军与展开快。",
     "effects": [{"hook": "march行军", "value": -0.05, "when": [["ctx.terrain", "in", ["mountains", "hills"]]]}, {"hook": "formation整队", "value": -0.05, "when": [["ctx.terrain", "in", ["mountains", "hills"]]]}]},
    {"id": "trait_039", "name": "守关轮值", "tier": "common", "mechanism_basis": "inferred", "summary": "固守时前后排轮换顺，组织不易被耗光。",
     "effects": [{"hook": "special轮换", "value": -0.05, "when": [["ctx.action", "in", ["hold", "defend"]]]}]},
    {"id": "trait_046", "name": "善骑", "tier": "common", "mechanism_basis": "gdd_8.3", "summary": "本人骑乘时骑术+2；骑兵占七成以上时行军快 3%；本人坠马少 2pp。",
     "effects": [{"hook": "attribute.骑术", "value": 2, "when": [["person.mounted", "==", true]]}, {"hook": "march行军", "value": -0.03, "when": [["unit.cavalry_ratio", ">=", 0.7]]}, {"hook": "personal失控", "value": -0.02}]},
    {"id": "trait_047", "name": "善射", "tier": "common", "mechanism_basis": "inferred", "summary": "本人射术+2；所部弓兵第一次齐射准备快。不加全军弓兵伤害。",
     "effects": [{"hook": "attribute.箭术", "value": 2}, {"hook": "special齐射", "value": -0.05, "when": [["unit.archer_ratio", ">=", 0.3]]}]},
    {"id": "trait_048", "name": "步战", "tier": "common", "mechanism_basis": "inferred", "summary": "本人步战武艺+2；步兵为主接战时疲劳增长少。",
     "effects": [{"hook": "attribute.武艺", "value": 2, "when": [["person.mounted", "==", false]]}, {"hook": "fatigue疲劳", "value": -0.03, "when": [["ctx.in_contact", "==", true], ["unit.infantry_ratio", ">=", 0.5]]}]},
    {"id": "trait_061", "name": "工事", "tier": "common", "mechanism_basis": "inferred", "summary": "工事与攻坚准备工时少。",
     "effects": [{"hook": "engineering准备", "value": -0.05}]},
    {"id": "trait_111", "name": "听辨", "tier": "common", "mechanism_basis": "inferred", "summary": "能从声响与尘迹辨出伏兵。",
     "effects": [{"hook": "ambush识破", "value": 0.02}]},

    {"id": "trait_011", "name": "令辞含混", "tier": "flaw", "mechanism_basis": "inferred", "summary": "命令写得含糊：整理耗时长，高压下更易出错。",
     "effects": [{"hook": "command整理", "value": 0.05}, {"hook": "pressure失误", "value": 0.02, "when": [["ctx.pressure", ">=", 0.5]]}]},
    {"id": "trait_026", "name": "追击疏算", "tier": "flaw", "mechanism_basis": "inferred", "summary": "追击时算不清退路，常越过最大深入一步。",
     "effects": [{"hook": "pursuit深入", "value": 1}]},

    {"id": "trait_c01", "name": "追击", "tier": "common", "mechanism_basis": "card", "summary": "敌溃后追击造成的伤亡与俘获多 3%。",
     "effects": [{"hook": "pursuit追击", "value": 0.03}]},
    {"id": "trait_c02", "name": "果决", "tier": "common", "mechanism_basis": "card", "summary": "时间紧时重规划快。",
     "effects": [{"hook": "replan重规划", "value": -0.04, "when": [["ctx.urgency", ">=", 0.5]]}]},
    {"id": "trait_c03", "name": "穿插", "tier": "common", "mechanism_basis": "card", "summary": "侧击穿插时不易暴露。",
     "effects": [{"hook": "conceal暴露", "value": -0.02, "when": [["ctx.action", "==", "flank"]]}]},
    {"id": "trait_c04", "name": "识水", "tier": "common", "mechanism_basis": "card", "summary": "涉水、渡口行军与整队快。",
     "effects": [{"hook": "march行军", "value": -0.05, "when": [["ctx.terrain", "in", ["river", "ford"]]]}, {"hook": "formation整队", "value": -0.05, "when": [["ctx.terrain", "in", ["river", "ford"]]]}]},

    {"id": "flaw_rash", "name": "急躁", "tier": "flaw", "mechanism_basis": "military_pages", "summary": "牵制或侧翼还没到位就投入主力。",
     "effects": [{"hook": "commit投入", "value": -0.5}]},
    {"id": "flaw_brawler", "name": "恋战", "tier": "flaw", "mechanism_basis": "military_pages", "summary": "组织跌到脱离线也不肯脱离。",
     "effects": [{"hook": "disengage脱离", "value": -15}]},
    {"id": "flaw_glory", "name": "贪功", "tier": "flaw", "mechanism_basis": "military_pages", "summary": "追击超出最大深入，容易被反扑。",
     "effects": [{"hook": "pursuit深入", "value": 2}]},
    {"id": "flaw_stubborn", "name": "刚愎", "tier": "flaw", "mechanism_basis": "military_pages", "summary": "否决参军建议，违令率高。",
     "effects": [{"hook": "advice采纳", "value": -0.15}, {"hook": "dissent违令", "value": 0.05}]},
    {"id": "flaw_timid", "name": "怯战", "tier": "flaw", "mechanism_basis": "military_pages", "summary": "组织未破就后撤。",
     "effects": [{"hook": "disengage脱离", "value": 20}]},
    {"id": "flaw_arrogant", "name": "骄矜", "tier": "flaw", "mechanism_basis": "card", "summary": "轻视名望低的对手：接战门槛偏低，对其兵力估计偏差大。",
     "effects": [{"hook": "commit投入", "value": -0.3, "when": [["ctx.enemy_renown_gap", ">=", 15]]}, {"hook": "intel误差", "value": 0.05, "when": [["ctx.enemy_renown_gap", ">=", 15]]}]},
    {"id": "flaw_indecisive", "name": "好谋少决", "tier": "flaw", "mechanism_basis": "card", "summary": "方案对立时裁断慢：重规划耗时长，投入前要更多把握。",
     "effects": [{"hook": "replan重规划", "value": 0.05}, {"hook": "commit投入", "value": 0.2}]},
    {"id": "flaw_caustic", "name": "言辞刻薄", "tier": "flaw", "mechanism_basis": "card", "summary": "向自尊高的主将进言时，建议被采纳的概率低。建议质量不变。",
     "effects": [{"hook": "advice说服", "value": -0.10, "when": [["ctx.lord_pride", ">=", 85]]}]},
    {"id": "flaw_micromanage", "name": "过度负责", "tier": "flaw", "mechanism_basis": "card", "summary": "下属的决定也要亲自过问：有部将时重规划耗时长。",
     "effects": [{"hook": "replan重规划", "value": 0.05, "when": [["ctx.subcommanders_assigned", "==", true]]}]},

    {"id": "unique_wusheng", "name": "武圣", "tier": "unique", "mechanism_basis": "card", "summary": "首次与名望≥80的敌将正面交锋时，敌直属部队士气−8；同一目标一次，远射与伏击不触发。",
     "mechanism": {"type": "first_contact_awe", "morale": 8, "min_enemy_renown": 80, "actions": ["engage", "continue"], "contact_memory": 64}},
    {"id": "unique_xiaobawang", "name": "小霸王", "tier": "unique", "mechanism_basis": "card", "summary": "上一场主动攻战取胜且间隔不超过 30 日时，下一场主动攻战首次接敌移动+8%、士气冲击+8%；失败清零。",
     "mechanism": {"type": "victory_chain", "window_days": 30, "march": 1.08, "shock": 1.08, "actions": ["engage", "continue"]}}
  ]
}
