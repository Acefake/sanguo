 ],
 "rewrite": [
  {
   "on": "kin_killed",
   "if": "data.killer != ''",
   "do": "add_or_replace",
   "drive": "报仇",
   "weight": 0.5,
   "object": "data.killer"
  },
  {
   "on": "object_died",
   "if": "has_drive('报仇')",
   "do": "remove",
   "drive": "报仇"
  },
  {
   "on": "yearly",
   "if": "age >= 55 and meter('功名') > 60",
   "do": "replace",
   "drive": "功名",
   "with": "second_highest_of(['家族','安身'])"
  },
  {
   "on": "lord_died",
   "if": "data.regent == self",
   "do": "add",
   "drive": "忠义",
   "weight": 0.5
  }
 ],
 "rewrite_cooldown_xun": 36,
 "exclusive": [
  [
   "安身",
   "报仇"
  ],
  [
   "财货",
   "忠义"
  ]
 ],
 "exclusive_habits": {
  "安身": [
   "habit_032",
   "habit_011"
  ],
  "忠义": [
   "habit_073"
  ]
 },
 "infer_from_card": {
  "功名": "values.功业*0.6 + decision_weights.个人功业*0.4",
  "忠义": "loyalty.承诺坚持*0.5 + values.承诺*0.5",
  "财货": "values.个人利益*0.7 + axis.贪欲/100*0.3",
  "家族": "loyalty.私人依附*0.4 + (kin.size()>0 ? 0.3 : 0)",
  "天下": "values.群体利益*0.6 + values.秩序*0.2 + axis.野心/100*0.2",
  "安身": "decision_weights.损失厌恶*0.6 + (1-risk_preference)*0.4",
  "学问": "attr.智计/100*0.4 + (has_learning_habit ? 0.4 : 0)",
  "报仇": "knot_object_intensity>=60 ? 0.8 : 0",
  "keep_second_if_ge": 0.15
 }
}