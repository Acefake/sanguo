 "rewrite": [
  {
   "on": "kin_killed",
   "if": "data.killer != ''",
   "do": "add_or_replace",
   "drive": "报仇",
   "weight": 0.5,
   "object": "data.killer"
  },
  {
   "on": "object_died",
   "if": "has_drive('报仇')",
   "do": "remove",
   "drive": "报仇"
  },
  {
   "on": "yearly",
   "if": "age >= 55 and meter('功名') > 60",
   "do": "replace",
   "drive": "功名",
   "with": "second_highest_of(['家族','安身'])"
  },
  {
   "on": "lord_died",
   "if": "data.regent == self",
   "do": "add",
   "drive": "忠义",
   "weight": 0.5
  }
 ],
 "rewrite_cooldown_xun": 36,
 "exclusive": [
  [
   "安身",
   "报仇"
  ],
  [
   "财货",
   "忠义"
  ]
 ],
 "exclusive_habits": {
  "安身": [
   "habit_032",
   "habit_011"
  ],
  "忠义": [
   "habit_073"
  ]
 },
 "infer_from_card": {
  "note": "仅在人物卡/补丁没有写 drives 时兜底（生成将、新登场人物）。补丁里的 drives 永远优先。只用 schema 6 卡上已有字段。v1.1 对官渡 20 人：首位一致 11/20，补丁首位落在推定前二 16/20。",
  "gong": "personality.decision_weights.个人功业，缺省取 功业偏好，再缺省取 values.功业",
  "score": {
   "功名": "0.5*values.功业 + 0.3*gong + 0.2*risk_preference + (attr.武艺>=85 ? 0.1 : 0)",
   "忠义": "0.4*loyalty.承诺坚持 + 0.35*loyalty.私人依附 + 0.25*attr.信义/100 - 0.15",
   "财货": "0.8*values.个人利益 + 0.2*(1-attr.信义/100) - 0.15",
   "家族": "0.4*loyalty.私人依附 + (kin.size()>0 ? 0.25 : 0) - 0.1",
   "天下": "0.45*values.群体利益 + 0.3*values.秩序 + 0.25*attr.智计/100 - 0.25 + (attr.智计>=88 ? 0.1 : 0)",
   "安身": "0.5*decision_weights.损失厌恶 + 0.5*(1-risk_preference) - 0.3",
   "学问": "0.3*attr.智计/100 - 0.2 + (has_learning_habit ? 0.4 : 0)",
   "报仇": "knot_object_intensity>=60 ? 0.8 : 0"
  },
  "pick": "取最高者；次高 ≥ 最高×0.85 时保留为第二心志；两条按分数归一，单条权重 1.0",
  "learning_habits": [
   "habit_078"
  ]
 },
 "signals": {
  "note": "drives.rules / rewrite 里用到、但不产生记忆的信号。全部由引擎发出，不由人物事件总线的 emit 产生记忆。",
  "idle_xun": {
   "source": "people_tick",
   "when": "旬末：本旬无任命、无出征、无军议发言",
   "phase": "P2"
  },
  "no_reward_xun": {
   "source": "people_tick",
   "when": "旬末：本旬未受赏",
   "phase": "P2"
  },
  "campaign_xun": {
   "source": "people_tick",
   "when": "旬末：本旬在出征军中",
   "phase": "P2"
  },
  "yearly": {
   "source": "people_tick",
   "when": "每年正月上旬",
   "phase": "P2"
  },
  "city_taken": {
   "source": "campaign_outcomes._capture_city",
   "when": "本势力攻占城池",
   "phase": "P2"
  },
  "city_besieged": {
   "source": "siege_system",
   "when": "本势力城池被围的第一日",
   "phase": "P2"
  },
  "main_army_lost": {
   "source": "campaign_outcomes._check_rout",
   "when": "溃败军团兵力 ≥ 本势力野战兵力 50%",
   "phase": "P2"
  },
  "sent_to_danger": {
   "source": "campaign_dispatch / army_corps",
   "when": "受命前往的战线估计敌我比 ≥ 1.5",
   "phase": "P2"
  },
  "peace_made": {
   "source": "diplomacy（未实现）",
   "when": "本势力与某势力议和",
   "phase": "P7"
  },
  "object_died": {
   "source": "lifecycle / officer_fate",
   "when": "某人死亡；对以其为心结对象者发出",
   "phase": "P2"
  }
 }
