; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="三国山河·秋日地图"
run/main_scene="res://scenes/rtk14_world_3d.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

GameState="*res://scripts/game_state.gd"

[display]

window/size/viewport_width=1260
window/size/viewport_height=710
window/size/window_width_override=1260
window/size/window_height_override=710
window/stretch/mode="canvas_items"

[gui]

theme/custom="res://assets/theme_kaiti.tres"

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/use_taa=true
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.055, 0.047, 0.039, 1)
